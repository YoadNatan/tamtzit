# Copy to .env.local for local development:  cp .env.example .env.local
# Names only. Fill the values in .env.local (never committed) and in Vercel →
# Settings → Environment Variables. docs/MOVE.md says where each one comes from.

# ── Supabase (public: the browser gets them too; RLS protects the data) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: the app in a Supabase project of its own (overrides the pair above).
# VITE_STUDY_SUPABASE_URL=
# VITE_STUDY_SUPABASE_ANON_KEY=

# ── Server only (Vercel functions; never in the browser) ──
# SECRET: the Anthropic API key.
ANTHROPIC_API_KEY=
# SECRET: the server key, 32+ characters; the same value as Supabase Vault's
# study_worker_key. Without it every call to Claude is refused.
STUDY_WORKER_KEY=
# The group's monthly cap for Claude, in dollars (approved: 33; code default 40).
STUDY_MONTHLY_USD=
# Declared for packages not built yet (no code reads them today):
# SECRET: the Supabase Send Email hook's secret (package A1).
# SEND_EMAIL_HOOK_SECRET=
# SECRET: the transcription provider's key (package W5).
# STUDY_TRANSCRIBE_KEY=

# ── Release flags (shared/study/flags.ts): "1" turns one on, unset is off ──
# Production only, then redeploy; keep them off in Preview, which uses the
# same database. Copy the old project's Production set exactly (docs/MOVE.md).
# VITE_STUDY_QUESTIONS=
# VITE_STUDY_PRACTICE=
# VITE_STUDY_CARDS=
# VITE_STUDY_CARDS_REVIEW=
# VITE_STUDY_QUIZ=
# VITE_STUDY_QUIZ_ROUNDS=
