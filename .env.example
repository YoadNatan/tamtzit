# Copy to .env.local for local development:  cp .env.example .env.local
# Names only. Fill the values in .env.local (never committed) and in Vercel →
# Settings → Environment Variables. docs/MOVE.md says where each one comes from.

# ── Supabase (public: the browser gets them too; RLS protects the data) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: the app in a Supabase project of its own (overrides the pair above).
# VITE_STUDY_SUPABASE_URL=
# VITE_STUDY_SUPABASE_ANON_KEY=

# ── Server only (Vercel functions; never in the browser) ──
# SECRET: the Anthropic API key.
ANTHROPIC_API_KEY=
# SECRET: the server key, 32+ characters; the same value as Supabase Vault's
# study_worker_key. Without it every call to Claude is refused.
STUDY_WORKER_KEY=
# The group's monthly cap for Claude, in dollars (approved: 33; 33 when unset).
STUDY_MONTHLY_USD=
# Practice sets' monthly line in dollars (kinds practice, solver, reword and
# style; approved: 12; 12 when unset). docs/study/sets.md.
# STUDY_SETS_MONTHLY_USD=
# Uploaded sheets' monthly line in dollars (reading, answers files and solving
# of exercise sheets; approved: 6; 6 when unset). docs/study/sheets.md.
# STUDY_SHEETS_MONTHLY_USD=
# Notifications' push keys (docs/study/RELEASE-R1.md): Production only, made on
# the owner's computer with `node tools/vapid-keys.mjs https://<the app>`.
# STUDY_VAPID_PUBLIC=
# SECRET (mark it Sensitive in Vercel): the private key.
# STUDY_VAPID_PRIVATE=
# STUDY_VAPID_SUBJECT=
# Declared for packages not built yet (no code reads them today):
# SECRET: the Supabase Send Email hook's secret (package A1).
# SEND_EMAIL_HOOK_SECRET=
# SECRET: the transcription provider's key (package W5).
# STUDY_TRANSCRIBE_KEY=

# ── Release flags (shared/study/flags.ts): "1" turns one on, unset is off ──
# Production only, then redeploy; keep them off in Preview, which uses the
# same database. Copy the old project's Production set exactly (docs/MOVE.md).
# VITE_STUDY_QUESTIONS=
# VITE_STUDY_PRACTICE=
# VITE_STUDY_CARDS=
# VITE_STUDY_CARDS_REVIEW=
# VITE_STUDY_QUIZ=
# VITE_STUDY_QUIZ_ROUNDS=
# VITE_STUDY_MEETING=
# VITE_STUDY_ANCHOR=
# VITE_STUDY_CORRECTIONS=
# VITE_STUDY_VAR=
# VITE_STUDY_ASK=
# VITE_STUDY_WALL=
# VITE_STUDY_GUESS=
# VITE_STUDY_PROGRESS=
# VITE_STUDY_TODAY=
# VITE_STUDY_PULSE=
# VITE_STUDY_MARATHONS=
# VITE_STUDY_GROUP_PLAN=
# VITE_STUDY_NEEDS_ME=
# VITE_STUDY_EVE=
# VITE_STUDY_MUSEUM=
# VITE_STUDY_BOSS=
# VITE_STUDY_TRAPS=
# VITE_STUDY_BLANK_TABLE=
# VITE_STUDY_GUIDE=
# VITE_STUDY_QTYPES=
# VITE_STUDY_INSTALL=
# VITE_STUDY_NOTIFY=
# Practice sets (docs/study/RELEASE-L1.md): MAKE first, then SETS after part 10.
# VITE_STUDY_MAKE=
# VITE_STUDY_SETS=
# VITE_STUDY_ACCOUNT=
# VITE_STUDY_PDF=
# VITE_STUDY_RECORDINGS=
# VITE_STUDY_EXAMS=
# Uploaded sheets, release A0 (docs/study/RELEASE-O.md): after part 10, with EXAMS.
# VITE_STUDY_SHEETS=
# e2e builds only, never in production: a fake recogniser.
# VITE_STUDY_FAKE_ASR=
